index=demo_ai_obs demo_name=ai_observability_conf26 sourcetype=ai:metric metric_name=ai_cost
| eventstats max(demo_run_epoch) as latest_demo_run
| where demo_run_epoch=latest_demo_run
| sort 0 - _time
| dedup keepempty=true trace_id metric_name retry_count
| stats sum(cost_usd) as total_cost sum(total_tokens) as total_tokens max(retry_count) as retries by trace_id user_id workflow prompt_type model_name
| eval total_cost=round(total_cost,2)
| where total_cost > 50 OR retries >= 4
| eval action=case(total_cost>100,"page",total_cost>50,"ticket",true(),"log")
| table trace_id user_id workflow prompt_type model_name total_tokens total_cost retries action
