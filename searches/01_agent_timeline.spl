index=demo_ai_obs demo_name=ai_observability_conf26 sourcetype=ai:agent_event event_sourcetype=ai:trace
| eventstats max(demo_run_epoch) as latest_run
| where demo_run_epoch=latest_run
| where isnotnull(span_name)
| eval step=case(
    span_name="user.request",             "1 User request",
    span_name="model.turn" AND turn_seq=1, "2 Model decides (turn 1)",
    span_name="tool.crm_query",           "3 CRM query — accounts pulled",
    span_name="tool.share_config_check",  "4 Share policy checked — no targets enabled",
    span_name="model.turn" AND turn_seq=2, "5 Model decides (turn 2)",
    span_name="tool.file_write",          "6 File created",
    span_name="model.turn",               "7 Final response",
    true(),                                span_name
  )
| eval detail=coalesce(tool_output_summary, request_summary, file_path)
| dedup trace_id event_sequence
| sort event_sequence
| table _time step user_id host span_name trace_id tool_name file_path policy_action detail
